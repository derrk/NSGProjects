# 940 Collector's Expo — backend config.
# Copy to .env.local for local dev, and add the same vars in Vercel → Project → Settings → Environment Variables.
# If these are absent, the reservation system automatically falls back to per-browser localStorage
# (fine for a demo, NOT authoritative). Set them to go live with a shared database.
#
# NEVER put real secrets in this file — it is committed to git. Real values go in .env.local (git-ignored).

# Supabase (Dashboard → Project Settings → API)
#   SUPABASE_URL = the "Project URL" (looks like https://xxxxxxxx.supabase.co) — NOT the Postgres connection string
#   SUPABASE_SERVICE_ROLE_KEY = the secret "service_role" key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passcode for the /admin page (pick anything; share only with Dustin)
ADMIN_PASSCODE=

# Public site URL (used for canonical/sitemap/OG + email links). Set to your real domain.
NEXT_PUBLIC_SITE_URL=https://940collectorsexpo.com

# Email (Resend — resend.com). If RESEND_API_KEY is absent, emails are skipped.
#   EMAIL_FROM: verify your domain in Resend, then use e.g. "940 Collector's Expo <tickets@940collectorsexpo.com>".
#   Until the domain is verified you can send from "940 Collector's Expo <onboarding@resend.dev>".
#   ADMIN_EMAIL: where new-hold notifications are sent (Dustin's inbox).
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=

