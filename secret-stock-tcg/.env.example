# ─────────────────────────────────────────────────────────────────────────────
# Secret Stock TX — environment variables
# Copy this file to `.env` and fill it in. Phase 1 only needs the two database
# URLs and the two admin values; everything below those is for later phases and
# the app runs fine with them blank.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Neon Postgres) -------------------------------------------------
# Create a project at neon.tech. It gives you two connection strings:
#   DATABASE_URL: the POOLED one (its host contains "-pooler"). Used by the app.
#   DIRECT_URL:   the DIRECT one. Used by Prisma migrations only.
# Use a database separate from the ESU store's — they share a schema shape, not data.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/secretstock?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/secretstock?sslmode=require"

# --- Admin gate ---------------------------------------------------------------
# ADMIN_PASSPHRASE:    what you type at /admin/login.
# ADMIN_SESSION_TOKEN: a long random secret; becomes the login cookie value.
#                      Generate one, e.g.:  openssl rand -hex 32
# Both must be set, or the admin refuses every login rather than falling open.
ADMIN_PASSPHRASE="change-me-to-a-real-passphrase"
ADMIN_SESSION_TOKEN="change-me-to-a-long-random-string"

# --- Product images (Vercel Blob) ---------------------------------------------
# Create a Blob store in the Vercel dashboard; it provides this token. Until it
# is set, the product form still works via its paste-a-URL fallback, and the
# seeded products keep using the photos already in /public/images.
BLOB_READ_WRITE_TOKEN=""

# --- Storefront ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Later phases — not read by anything yet ─────────────────────────────────

# Flat-rate shipping charged at checkout, in cents (e.g. 500 = $5.00).
NEXT_PUBLIC_DEFAULT_SHIPPING_CENTS="500"
# Free shipping once the cart subtotal reaches this many cents (0 = never).
NEXT_PUBLIC_FREE_SHIPPING_OVER_CENTS="10000"

# Default parcel box dimensions (inches) used for rating.
DEFAULT_PARCEL_LENGTH_IN="9"
DEFAULT_PARCEL_WIDTH_IN="6"
DEFAULT_PARCEL_HEIGHT_IN="3"

# Sell-request notification endpoint (Formspree or similar). Empty disables the
# email; the request is still saved to the database and shows in the admin.
# Keep this empty locally so test submissions do not email real leads.
SELL_NOTIFY_URL=""
