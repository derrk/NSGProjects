# This lives in a PUBLIC repository. Nothing personal goes in.

# Charging history and anything derived from it: VIN, session times, site
# locations, invoice numbers, amounts paid.
data/untrusted/
data/visited.json
results/

# Built pages embed the history, the visited set and the day-by-day plan, so they
# stay local. Templates are source and are tracked; anything built from them is not.
# Regenerate with the matching src/build-*.js.
web/*.html
!web/*.template.html

# Downloaded third-party data and routing responses: large and reproducible.
# See the README for how to fetch them again.
data/allSites.json
data/allSites.meta.json
data/route-cache/

node_modules/
