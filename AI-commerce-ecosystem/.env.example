# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Database (Supabase -> Project Settings -> Database -> Connection string)
# ---------------------------------------------------------------------------
# Runtime: TRANSACTION pooler, port 6543. The client sets prepare:false for this
# automatically (Supavisor keeps no session state).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Migrations: SESSION pooler, port 5432. NOT the direct db.PROJECT_REF.supabase.co
# host — that one is IPv6-only unless you pay for the IPv4 add-on, so it simply hangs
# on most home and corporate networks. Note the username is postgres.PROJECT_REF, not
# postgres, and the aws-N index is not derivable — copy the string from the dashboard.
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase API (storage + realtime; Drizzle owns SQL)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# New-style keys. The legacy anon/service_role JWTs still work but Supabase is
# retiring them by the end of 2026. These are NOT JWTs: hand-rolled fetch calls must
# send them in the `apikey` header, never as `Authorization: Bearer`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server only. Never prefix this NEXT_PUBLIC_ — Next.js would inline it into the
# browser bundle.
SUPABASE_SECRET_KEY="sb_secret_..."

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
FAL_KEY="..."
TAVILY_API_KEY="..."

# ---------------------------------------------------------------------------
# Inngest
# ---------------------------------------------------------------------------
# The v4 SDK defaults to CLOUD mode. Without this, local sync fails with a
# signing-key error that looks like a networking problem.
INNGEST_DEV=1
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Storefront and fulfillment (week 1 checklist item 5 — created by hand)
# ---------------------------------------------------------------------------
PRINTIFY_API_TOKEN=""
PRINTIFY_SHOP_ID=""
SHOPIFY_SHOP_DOMAIN="your-shop.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_..."
SHOPIFY_WEBHOOK_SECRET=""
